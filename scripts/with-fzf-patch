#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

# Patch a private copy, never the shared Go module cache.
go mod download github.com/junegunn/fzf
source=$(go list -m -f '{{.Dir}}' github.com/junegunn/fzf)
work=$(mktemp -d /tmp/tap-fzf.XXXXXX)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

cp -R "$source" "$work/fzf"
chmod -R u+w "$work/fzf"
patch --batch --forward --silent -d "$work/fzf" -p1 < patches/fzf-select-eintr.patch
cp go.mod go.sum "$work/"
go mod edit -modfile="$work/go.mod" -replace="github.com/junegunn/fzf=$work/fzf"

# Child Go commands, including benchmark builds, inherit the same patch.
export GOFLAGS="${GOFLAGS:+$GOFLAGS }-modfile=$work/go.mod -mod=readonly"
"$@"
